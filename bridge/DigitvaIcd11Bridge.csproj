<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <IcdApiBundleDir Condition="'$(IcdApiBundleDir)' == ''">../runtime/icdapi</IcdApiBundleDir>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="ICD-API">
      <HintPath>$(IcdApiBundleDir)/ICD-API.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="DorisRuleEngine">
      <HintPath>$(IcdApiBundleDir)/DorisRuleEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="OCT">
      <HintPath>$(IcdApiBundleDir)/OCT.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
